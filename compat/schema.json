{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BlueMap3D compatibility rules",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "match"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "priority": {
            "type": "integer",
            "default": 0
          },
          "scope": {
            "type": "array",
            "items": {
              "enum": [
                "terrain",
                "moving"
              ]
            },
            "default": [
              "terrain",
              "moving"
            ]
          },
          "match": {
            "type": "object",
            "properties": {
              "blocks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "properties": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "tint": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "none",
                  "fixed",
                  "palette"
                ]
              },
              "color": {
                "type": "string"
              },
              "palette": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "defaultColor": {
                "type": "string"
              },
              "defaultByBlock": {
                "type": "array"
              },
              "value": {
                "type": "object"
              }
            }
          },
          "model": {
            "type": "object",
            "required": [
              "type",
              "sourceBlock"
            ],
            "properties": {
              "type": {
                "const": "alias"
              },
              "sourceBlock": {
                "type": "string",
                "minLength": 1,
                "description": "Alias template. Supports ${id}, ${namespace}, ${path}, ${path0}/${path1}/..., and 1-based wildcard captures ${1}, ${2}, ... from '*' in the matched block glob."
              }
            }
          }
        }
      }
    },
    "moving": {
      "type": "object",
      "properties": {
        "modelNamespaces": {
          "type": "object",
          "properties": {
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
