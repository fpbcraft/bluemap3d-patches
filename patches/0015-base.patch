diff --git a/core/src/main/java/dev/duzo/bluemap3d/bake/CopycatsBoardSource.java b/core/src/main/java/dev/duzo/bluemap3d/bake/CopycatsBoardSource.java
new file mode 100644
index 0000000..d860ac3
--- /dev/null
+++ b/core/src/main/java/dev/duzo/bluemap3d/bake/CopycatsBoardSource.java
@@ -0,0 +1,209 @@
+package dev.duzo.bluemap3d.bake;
+
+import net.minecraft.core.Direction;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.nbt.NbtUtils;
+import net.minecraft.nbt.Tag;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.properties.Property;
+
+import java.awt.image.BufferedImage;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Dynamic server-side renderer for Copycats+' copycat_board.
+ *
+ * <p>Copycats+ stores each enabled face in MaterialItemStorage:
+ * material_data.&lt;face&gt;.material. Create contraptions may wrap the original full NBT
+ * and update tag; Sable supplies the block entity's full saved NBT. This source accepts
+ * all of those without linking against Copycats+.
+ */
+public final class CopycatsBoardSource implements BlockModelSource {
+    private static final String BOARD_ID = "copycats:copycat_board";
+    private static final String WHITE = "bluemap3d:copycat_white";
+    private static final float PIXEL = 1f;
+    private static final Set<String> MATERIAL_DATA_NAMES =
+            Set.of("material_data", "MaterialData", "materials", "Materials");
+
+    private final ResourcePackSource models;
+
+    public CopycatsBoardSource(ResourcePackSource models) {
+        this.models = models;
+    }
+
+    @Override
+    public List<ModelQuad> quadsFor(BlockState state) {
+        return List.of();
+    }
+
+    @Override
+    public List<ModelQuad> quadsFor(BlockState state, CompoundTag metadata) {
+        if (!BOARD_ID.equals(BuiltInRegistries.BLOCK.getKey(state.getBlock()).toString())
+                || metadata == null) {
+            return List.of();
+        }
+
+        CompoundTag materialData = findMaterialData(metadata, 0);
+        CompoundTag singleMaterial = findSingleMaterial(metadata, 0);
+        if (materialData == null && singleMaterial == null) {
+            return List.of();
+        }
+
+        List<ModelQuad> out = new ArrayList<>(36);
+        for (Direction boardFace : Direction.values()) {
+            String property = boardFace.getName();
+            if (!booleanProperty(state, property)) {
+                continue;
+            }
+
+            CompoundTag materialTag = null;
+            if (materialData != null && materialData.contains(property, Tag.TAG_COMPOUND)) {
+                materialTag = findSingleMaterial(materialData.getCompound(property), 0);
+            }
+            if (materialTag == null) {
+                materialTag = singleMaterial;
+            }
+            if (materialTag == null) {
+                continue;
+            }
+
+            BlockState material;
+            try {
+                material = NbtUtils.readBlockState(BuiltInRegistries.BLOCK.asLookup(), materialTag);
+            } catch (RuntimeException ex) {
+                continue;
+            }
+            addBoard(out, boardFace, material);
+        }
+        return out.isEmpty() ? List.of() : List.copyOf(out);
+    }
+
+    @Override
+    public BufferedImage texture(String texture) {
+        return WHITE.equals(texture) ? null : models.texture(texture);
+    }
+
+    @Override
+    public boolean occludes(BlockState state) {
+        return false;
+    }
+
+    private static CompoundTag findMaterialData(CompoundTag tag, int depth) {
+        if (tag == null || depth > 6) return null;
+        for (String name : MATERIAL_DATA_NAMES) {
+            if (tag.contains(name, Tag.TAG_COMPOUND)) {
+                CompoundTag value = tag.getCompound(name);
+                if (!value.isEmpty()) return value;
+            }
+        }
+        for (String key : tag.getAllKeys()) {
+            Tag child = tag.get(key);
+            if (child instanceof CompoundTag compound) {
+                CompoundTag found = findMaterialData(compound, depth + 1);
+                if (found != null) return found;
+            }
+        }
+        return null;
+    }
+
+    /** Returns the serialized BlockState compound, not its MaterialItem parent. */
+    private static CompoundTag findSingleMaterial(CompoundTag tag, int depth) {
+        if (tag == null || depth > 6) return null;
+        for (String name : List.of("material", "Material")) {
+            if (tag.contains(name, Tag.TAG_COMPOUND)) {
+                CompoundTag value = tag.getCompound(name);
+                if (!value.isEmpty()) return value;
+            }
+        }
+        for (String key : tag.getAllKeys()) {
+            Tag child = tag.get(key);
+            if (child instanceof CompoundTag compound) {
+                CompoundTag found = findSingleMaterial(compound, depth + 1);
+                if (found != null) return found;
+            }
+        }
+        return null;
+    }
+
+    private void addBoard(List<ModelQuad> out, Direction boardFace, BlockState material) {
+        float[] from = {0f, 0f, 0f};
+        float[] to = {16f, 16f, 16f};
+        switch (boardFace) {
+            case DOWN -> to[1] = PIXEL;
+            case UP -> from[1] = 16f - PIXEL;
+            case NORTH -> to[2] = PIXEL;
+            case SOUTH -> from[2] = 16f - PIXEL;
+            case WEST -> to[0] = PIXEL;
+            case EAST -> from[0] = 16f - PIXEL;
+        }
+
+        for (Direction surface : Direction.values()) {
+            Appearance appearance = appearance(material, surface);
+            out.add(new ModelQuad(
+                    cullFaceOf(from, to, surface),
+                    surface,
+                    ResourcePackGeometry.faceCorners(from, to, surface),
+                    ResourcePackGeometry.uvCorners(
+                            ResourcePackGeometry.autoUv(from, to, surface), 0),
+                    appearance.texture(),
+                    appearance.tint()));
+        }
+    }
+
+    private Appearance appearance(BlockState material, Direction surface) {
+        List<ModelQuad> materialQuads = models.quadsFor(material);
+        ModelQuad first = materialQuads.isEmpty() ? null : materialQuads.getFirst();
+        ModelQuad chosen = null;
+        for (ModelQuad quad : materialQuads) {
+            if (quad.cullFace() == surface) {
+                chosen = quad;
+                break;
+            }
+            if (chosen == null && quad.shadeFace() == surface) chosen = quad;
+        }
+        if (chosen == null) chosen = first;
+        if (chosen != null && chosen.texture() != null
+                && models.texture(chosen.texture()) != null) {
+            return new Appearance(chosen.texture(), chosen.tint());
+        }
+
+        String particle = models.particleTexture(material);
+        if (particle != null && models.texture(particle) != null) {
+            return new Appearance(particle, 0xFFFFFF);
+        }
+
+        int tint = MapColorSource.mapColorOf(material);
+        return new Appearance(WHITE, tint < 0 ? 0xFFFFFF : tint);
+    }
+
+    private static Direction cullFaceOf(float[] from, float[] to, Direction face) {
+        boolean flush = switch (face) {
+            case DOWN -> from[1] <= 0f;
+            case UP -> to[1] >= 16f;
+            case NORTH -> from[2] <= 0f;
+            case SOUTH -> to[2] >= 16f;
+            case WEST -> from[0] <= 0f;
+            case EAST -> to[0] >= 16f;
+        };
+        return flush ? face : null;
+    }
+
+    private static boolean booleanProperty(BlockState state, String name) {
+        for (Property<?> property : state.getProperties()) {
+            if (property.getName().equals(name)) {
+                return "true".equals(valueName(state, property));
+            }
+        }
+        return false;
+    }
+
+    private static <T extends Comparable<T>> String valueName(
+            BlockState state, Property<T> property) {
+        return property.getName(state.getValue(property));
+    }
+
+    private record Appearance(String texture, int tint) {}
+}
