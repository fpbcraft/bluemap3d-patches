+package dev.duzo.bluemap3d.create;
+
+import dev.duzo.bluemap3d.api.ModelAttachment;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.resources.ResourceLocation;
+import net.minecraft.world.level.block.state.BlockState;
+import org.joml.Matrix4f;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Server-side reconstruction of Create: Blocks & Bogies ({@code create_bb}) bogey styles.
+ *
+ * <p>BnB's styles are client renderer code rather than block models. On a dedicated server
+ * BlueMap3D can still see the style id and the concrete bogey block, and all partial model
+ * assets are present in the mod jar. This class maps those stable inputs to the frame and
+ * axle models without linking against BnB classes.
+ *
+ * <p>V11 intentionally covers the structural running gear first: frame + every axle/wheel,
+ * with wheel motion. Connecting rods, Walschaerts links, sliders and belt UV scrolling are
+ * not required for the bogey to exist on the map and need their own compound motion model.
+ */
+final class BlocksBogiesStyles {
+    private static final String NAMESPACE = "create_bb";
+
+    private BlocksBogiesStyles() {
+    }
+
+    static List<ModelAttachment> attachmentsFor(
+            String styleId, BlockPos pos, Direction.Axis axis, BlockState state) {
+        if (styleId == null || !styleId.startsWith(NAMESPACE + ":")) {
+            return List.of();
+        }
+
+        ResourceLocation blockId = BuiltInRegistries.BLOCK.getKey(state.getBlock());
+        if (!NAMESPACE.equals(blockId.getNamespace())) {
+            return List.of();
+        }
+
+        String style = styleId.substring(styleId.indexOf(':') + 1);
+        int axles = axleCount(style);
+        if (axles <= 0) {
+            return List.of();
+        }
+
+        String blockPath = blockId.getPath();
+        if (blockPath.startsWith("s_")) {
+            return small(style, pos, axis, axles);
+        }
+
+        boolean extraLarge = blockPath.startsWith("xl_");
+        if (!extraLarge && !blockPath.startsWith("l_")) {
+            return List.of();
+        }
+        return drivers(style, pos, axis, axles, extraLarge);
+    }
+
+    private static List<ModelAttachment> small(
+            String style, BlockPos pos, Direction.Axis axis, int axles) {
+        String stem;
+        if (style.endsWith("_trailing")) {
+            stem = "t" + (axles * 2);
+        } else if ("single_axle_offset".equals(style)) {
+            stem = "s2e";
+        } else if (style.endsWith("_bogie")) {
+            stem = "s" + (axles * 2);
+        } else {
+            return List.of();
+        }
+
+        List<ModelAttachment> out = new ArrayList<>();
+        out.add(new ModelAttachment(
+                pos,
+                bb("block/bogie/small/" + stem + "/frame"),
+                Map.of(),
+                frameTransform(axis)));
+
+        ResourceLocation wheels = bb("block/bogie/small/shared/wheels");
+        float center = (axles - 1) / 2f;
+        for (int i = 0; i < axles; i++) {
+            float z = i - center;
+            out.add(wheel(
+                    pos, axis, wheels, -0.75f, z,
+                    ContraptionProvider.WHEEL_RADIUS_SMALL));
+        }
+        return List.copyOf(out);
+    }
+
+    private static List<ModelAttachment> drivers(
+            String style, BlockPos pos, Direction.Axis axis, int axles, boolean extraLarge) {
+        String code = familyCode(style);
+        if (code == null) {
+            return List.of();
+        }
+
+        // BnB intentionally delegates the LARGE single-axle Scotch Yoke style to Create's
+        // own standard-large renderer. There is no create_bb:block/bogie/large/l2c/frame.
+        // The XL variant is a real BnB partial and is supported here.
+        if (!extraLarge && axles == 1 && "c".equals(code)) {
+            return List.of();
+        }
+
+        String root = extraLarge ? "extra_large" : "large";
+        String prefix = extraLarge ? "xl" : "l";
+        String stem = prefix + (axles * 2) + code;
+        ResourceLocation frame = bb("block/bogie/" + root + "/" + stem + "/frame");
+
+        List<ModelAttachment> out = new ArrayList<>();
+        out.add(new ModelAttachment(pos, frame, Map.of(), frameTransform(axis)));
+
+        boolean rodless = style.contains("rodless");
+        String wheelRoot = "block/bogie/" + root + "/shared/";
+        float[] positions = axlePositions(axles, extraLarge);
+        float wheelY = extraLarge ? -0.25f : -0.5f;
+        float radius = extraLarge ? 16.5f : 12.5f;
+
+        for (int i = 0; i < positions.length; i++) {
+            WheelKind kind = wheelKind(axles, i);
+            String model = switch (kind) {
+                case NORMAL -> rodless ? "wheels_single" : "wheels";
+                case SEMI_BLIND -> rodless ? "wheels_s_b_single" : "wheels_s_b";
+                case BLIND -> rodless ? "wheels_b_single" : "wheels_b";
+            };
+            out.add(wheel(pos, axis, bb(wheelRoot + model), wheelY, positions[i], radius));
+        }
+
+        return List.copyOf(out);
+    }
+
+    private static Matrix4f frameTransform(Direction.Axis axis) {
+        // BnB frames are rendered with no static translation. BlueMap3D's attachment
+        // convention needs the same -1.5 block correction already established for other
+        // renderer-authored bogey partials.
+        return ContraptionProvider.bogeyTransform(
+                axis,
+                ContraptionProvider.BOGEY_DROP + ContraptionProvider.BOGEY_DRIVE_HEIGHT,
+                0f);
+    }
+
+    private static ModelAttachment wheel(
+            BlockPos pos, Direction.Axis axis, ResourceLocation model,
+            float y, float z, float radius) {
+        Matrix4f transform = ContraptionProvider.bogeyTransform(axis, y, z);
+        ModelAttachment.Spin spin = new ModelAttachment.Spin(
+                ContraptionProvider.WHEEL_PIVOT,
+                ContraptionProvider.WHEEL_AXIS,
+                radius);
+        return new ModelAttachment(pos, model, Map.of(), transform, spin);
+    }
+
+    private static float[] axlePositions(int axles, boolean extraLarge) {
+        if (extraLarge) {
+            // BnB XL drivers are uniformly 2.25 blocks apart.
+            float[] out = new float[axles];
+            float center = (axles - 1) / 2f;
+            for (int i = 0; i < axles; i++) {
+                out[i] = (i - center) * 2.25f;
+            }
+            return out;
+        }
+
+        // Read from BnB's 1.21.1 renderer classes. Odd-count large drivers use
+        // 1.6875 spacing; even-count drivers use 1.75 spacing.
+        float spacing = (axles & 1) == 0 ? 1.75f : 1.6875f;
+        float[] out = new float[axles];
+        float center = (axles - 1) / 2f;
+        for (int i = 0; i < axles; i++) {
+            out[i] = (i - center) * spacing;
+        }
+        return out;
+    }
+
+    private static WheelKind wheelKind(int axles, int index) {
+        if (axles <= 2) {
+            return WheelKind.NORMAL;
+        }
+
+        float centerDistance = Math.abs(index - (axles - 1) / 2f);
+        if ((axles & 1) == 1 && centerDistance < 0.01f) {
+            return axles >= 5 ? WheelKind.BLIND : WheelKind.SEMI_BLIND;
+        }
+        if ((axles & 1) == 0 && centerDistance < 1f) {
+            return axles >= 6 ? WheelKind.BLIND : WheelKind.SEMI_BLIND;
+        }
+        if (axles >= 5 && centerDistance < 2f) {
+            return WheelKind.SEMI_BLIND;
+        }
+        return WheelKind.NORMAL;
+    }
+
+    private static String familyCode(String style) {
+        if (style.contains("pistonless") || style.contains("rodless")) {
+            return style.contains("extended") ? "ep" : "p";
+        }
+        if (style.contains("scotch_yoke")) {
+            return "c";
+        }
+
+        boolean walschaerts = style.contains("walschaerts");
+        if (style.contains("extra_long") || style.contains("extended_long")) {
+            return walschaerts ? "lew" : "le";
+        }
+        if (style.contains("extended_short")) {
+            return walschaerts ? "sew" : "se";
+        }
+        if (style.endsWith("_long")) {
+            return walschaerts ? "lw" : "l";
+        }
+        if (style.endsWith("_short")) {
+            return walschaerts ? "sw" : "s";
+        }
+        return null;
+    }
+
+    private static int axleCount(String style) {
+        if (style.startsWith("single_axle_")) return 1;
+        if (style.startsWith("double_axle_")) return 2;
+        if (style.startsWith("triple_axle_")) return 3;
+        if (style.startsWith("quadruple_axle_")) return 4;
+        if (style.startsWith("quintuple_axle_")) return 5;
+        if (style.startsWith("sextuple_axle_")) return 6;
+        return -1;
+    }
+
+    private static ResourceLocation bb(String path) {
+        return ResourceLocation.fromNamespaceAndPath(NAMESPACE, path);
+    }
+
+    private enum WheelKind {
+        NORMAL,
+        SEMI_BLIND,
+        BLIND
+    }
+}
