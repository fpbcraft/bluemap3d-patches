diff --git a/core/src/main/java/dev/duzo/bluemap3d/publish/GameTimePublisher.java b/core/src/main/java/dev/duzo/bluemap3d/publish/GameTimePublisher.java
new file mode 100644
--- /dev/null
+++ b/core/src/main/java/dev/duzo/bluemap3d/publish/GameTimePublisher.java
@@ -0,0 +1,148 @@
+package dev.duzo.bluemap3d.publish;
+
+import com.google.gson.Gson;
+import com.google.gson.JsonObject;
+import de.bluecolored.bluemap.api.BlueMapAPI;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.level.GameRules;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+
+/**
+ * Publishes the live Minecraft clock used by the optional BlueMap lighting sync.
+ *
+ * <p>The browser setting is enabled by default but can be disabled per browser. This
+ * publisher only makes the current time available; it never changes BlueMap's lighting
+ * on the server side.
+ */
+public final class GameTimePublisher {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger("BlueMap3D/GameTime");
+    private static final Gson GSON = new Gson();
+
+    private static final String BASE = "assets/bluemap3d";
+    private static final String SCRIPT_URL = BASE + "/game-time-sync.js";
+    private static final String CORE_SCRIPT_URL = BASE + "/game-time-sync.core.js";
+    private static final String FEED_URL = BASE + "/game-time.json";
+
+    private final BlueMapAPI api;
+    private final Path webRoot;
+    private int ticksUntilPublish;
+
+    private GameTimePublisher(BlueMapAPI api, Path webRoot) {
+        this.api = api;
+        this.webRoot = webRoot;
+    }
+
+    /**
+     * Installs the stable loader and registers it with BlueMap's webapp.
+     *
+     * @return a publisher, or {@code null} if the web root cannot be prepared
+     */
+    public static GameTimePublisher install(BlueMapAPI api) {
+        Path webRoot;
+        try {
+            webRoot = api.getWebApp().getWebRoot();
+        } catch (RuntimeException e) {
+            LOGGER.warn("BlueMap did not expose a web root; game-time lighting sync is disabled", e);
+            return null;
+        }
+
+        try {
+            copyResource("game-time-sync.js", resolve(webRoot, SCRIPT_URL));
+            copyResource("game-time-sync.core.js", resolve(webRoot, CORE_SCRIPT_URL));
+        } catch (IOException e) {
+            LOGGER.warn("Could not install BlueMap game-time lighting sync", e);
+            return null;
+        }
+
+        api.getWebApp().registerScript(SCRIPT_URL);
+        return new GameTimePublisher(api, webRoot);
+    }
+
+    /** Publishes at the same cadence as the ordinary BlueMap3D live feed. */
+    public void tick(MinecraftServer server, int intervalTicks) {
+        if (ticksUntilPublish > 0) {
+            ticksUntilPublish--;
+            return;
+        }
+        ticksUntilPublish = Math.max(1, intervalTicks) - 1;
+
+        try {
+            writeFeed(server);
+        } catch (IOException | RuntimeException e) {
+            LOGGER.debug("Could not publish game-time feed: {}", e.toString());
+        }
+    }
+
+    private void writeFeed(MinecraftServer server) throws IOException {
+        JsonObject maps = new JsonObject();
+
+        for (ServerLevel level : server.getAllLevels()) {
+            try {
+                api.getWorld(level).ifPresent(world -> world.getMaps().forEach(map -> {
+                    JsonObject state = new JsonObject();
+                    state.addProperty("dayTime", level.getDayTime());
+                    state.addProperty(
+                            "daylightCycle",
+                            level.getGameRules().getBoolean(GameRules.RULE_DAYLIGHT));
+                    state.addProperty("hasSkyLight", level.dimensionType().hasSkyLight());
+                    state.addProperty("dimension", level.dimension().location().toString());
+                    maps.add(map.getId(), state);
+                }));
+            } catch (RuntimeException e) {
+                LOGGER.debug(
+                        "Could not resolve BlueMap world time for {}: {}",
+                        level.dimension().location(),
+                        e.toString());
+            }
+        }
+
+        JsonObject root = new JsonObject();
+        root.add("maps", maps);
+        byte[] bytes = GSON.toJson(root).getBytes(StandardCharsets.UTF_8);
+
+        Path target = resolve(webRoot, FEED_URL);
+        Files.createDirectories(target.getParent());
+        Path temp = target.resolveSibling(target.getFileName() + ".tmp");
+        Files.write(temp, bytes);
+        try {
+            Files.move(
+                    temp,
+                    target,
+                    StandardCopyOption.REPLACE_EXISTING,
+                    StandardCopyOption.ATOMIC_MOVE);
+        } catch (IOException e) {
+            Files.move(temp, target, StandardCopyOption.REPLACE_EXISTING);
+        }
+    }
+
+    private static void copyResource(String name, Path target) throws IOException {
+        Files.createDirectories(target.getParent());
+        try (InputStream in = GameTimePublisher.class
+                .getResourceAsStream("/assets/bluemap3d/web/" + name)) {
+            if (in == null) {
+                throw new IOException(name + " is missing from the mod jar");
+            }
+            Files.copy(in, target, StandardCopyOption.REPLACE_EXISTING);
+        }
+    }
+
+    private static Path resolve(Path webRoot, String webRelative) {
+        Path root = webRoot.normalize();
+        Path path = root.resolve(webRelative).normalize();
+        if (!path.startsWith(root)) {
+            throw new IllegalArgumentException(
+                    "Refusing to write outside the BlueMap web root: " + webRelative);
+        }
+        return path;
+    }
+}
