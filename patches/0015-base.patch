+    /**
+     * Creates a detached scene object from any BM3D URL.
+     *
+     * Used by Player History for archived geometry. Geometry, texture and material stay
+     * in BlueMap3D's normal caches, so historical instances share GPU resources with
+     * each other and with live objects.
+     */
+    function createReplayMesh(url, label) {
+        return loadMesh(url).then(function (resource) {
+            resource.geometry.setDrawRange(0, resource.staticIndexCount);
+
+            var mesh = new THREE.Mesh(resource.geometry, resource.material);
+            mesh.frustumCulled = true;
+            mesh.matrixAutoUpdate = true;
+            if (label) {
+                mesh.name = label;
+            }
+
+            var roll = entryRoll(resource.nodes);
+            var signs = new Array(resource.nodes.length);
+            for (var s = 0; s < resource.nodes.length; s++) {
+                signs[s] = roll ? nodeForward(resource.nodes[s]).dot(roll) : 0;
+            }
+
+            for (var i = 0; i < resource.nodes.length; i++) {
+                var node = resource.nodes[i];
+                var group = new THREE.Group();
+                group.position.copy(node.pivot);
+
+                var nodeMesh = new THREE.Mesh(
+                    resource.nodeGeometries[i], resource.material);
+                nodeMesh.position.copy(node.pivot).negate();
+                nodeMesh.frustumCulled = true;
+                nodeMesh.matrixAutoUpdate = true;
+                group.add(nodeMesh);
+                mesh.add(group);
+            }
+
+            mesh.userData.bluemap3dReplayNodes = resource.nodes;
+            mesh.userData.bluemap3dReplaySigns = signs;
+            return mesh;
+        });
+    }
+
+    /**
+     * Applies a deterministic pose to a detached/replayed BM3D mesh.
+     *
+     * Travel-driven nodes use the historical signed odometer supplied by Player History.
+     * Rate-driven nodes use absolute replay time instead of wall-clock time, so pausing,
+     * seeking and reverse playback all land on the same pose for the same timestamp.
+     */
+    function setReplayAnimation(mesh, travel, timeSeconds) {
+        if (!mesh || !mesh.userData) {
+            return;
+        }
+        var nodes = mesh.userData.bluemap3dReplayNodes;
+        var signs = mesh.userData.bluemap3dReplaySigns;
+        if (!nodes || !signs) {
+            return;
+        }
+
+        for (var i = 0; i < nodes.length && i < mesh.children.length; i++) {
+            var node = nodes[i];
+            var group = mesh.children[i];
+            var value = travel * signs[i];
+
+            if (node.kind === KIND_OSCILLATE) {
+                var offset = node.period > 0
+                    ? node.radius * Math.sin(value / node.period) : 0;
+                group.position.set(
+                    node.axis.x * offset,
+                    node.axis.y * offset,
+                    node.axis.z * offset);
+                group.quaternion.set(0, 0, 0, 1);
+            } else if (node.kind === KIND_ORBIT) {
+                var theta = node.period > 0 ? value / node.period : 0;
+                group.position.copy(node.pivot).applyAxisAngle(node.axis, theta);
+                group.quaternion.set(0, 0, 0, 1);
+            } else if (node.kind === KIND_RATE) {
+                var angle = node.rate * timeSeconds;
+                /* Keep huge epoch-based angles numerically tame while preserving phase. */
+                angle = angle % (Math.PI * 2);
+                group.position.copy(node.pivot);
+                group.quaternion.setFromAxisAngle(node.axis, angle);
+            } else {
+                group.position.copy(node.pivot);
+                group.quaternion.setFromAxisAngle(
+                    node.axis, node.radius > 0 ? value / node.radius : 0);
+            }
+        }
+    }
+
