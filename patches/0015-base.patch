+    private void persist(PendingSnapshot pending, boolean force) {
+        long now = System.nanoTime();
+        synchronized (cacheLock) {
+            Map<String, SavedShip> saved =
+                    savedByFile.computeIfAbsent(pending.file(), ignored -> new ConcurrentHashMap<>());
+            SavedShip previous = saved.get(pending.key());
+            if (pending.ship().equals(previous)) {
+                return;
+            }
